<div id="<%= dom_id comment %>" class="w-full sm:w-auto py-5 space-y-5">
  <div class="flex flex-col">
    <p>
      <strong class="font-medium mb-1"><%= current_user.email %></strong>
      <span class="text-sm opacity-60"><%= comment.created_at.to_formatted_s(:short) %></span>
    </p>

    <p><%= comment.content %></p>
  </div>
</div>
