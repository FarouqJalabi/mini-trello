<%= form_with(model: [@list, card], class: "contents space-y-4") do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title, class: "input block", autofocus: true %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.rich_textarea :description %> 
  </div>

  <%= form.submit "Save", class: "btn btn-primary" %>
<% end %>
