<% content_for :title, "Showing card" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing card</h1>

  <%= render @card %>

  <%= link_to "Edit", edit_card_path(@card), class: "btn btn-primary" %>
  <%= link_to "Back to board", board_path(@card.board), class: "btn" %>
  <%= button_to "Destroy this card", @card, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
</div>
