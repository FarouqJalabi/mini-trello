<% content_for :title, "Boards" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Boards</h1>
    <%= link_to new_board_path, class: "btn btn-primary", data: { turbo_frame: "modal" } do %>
      New board
      <i class="bi bi-plus-square-fill"></i>
    <% end %>
  </div>

  <div id="boards" class="min-w-full flex flex-wrap gap-5">
    <% if @boards.any? %>
      <%= render @boards %>
    <% else %>
      <p class="text-center my-10">No boards found.</p>
    <% end %>
  </div>
</div>
