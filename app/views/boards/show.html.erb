<% content_for :title, "Showing board" %>
<input type="radio" class="theme-controller" name="theme" value="<%= @board.theme %>" checked hidden />

<%= turbo_page_requires_reload %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex items-center">
    <h1 class="font-bold text-4xl mr-auto"><%= @board.title %></h1>
    
    <%= link_to edit_board_path(@board), class: "btn btn-primary", data: {turbo_frame: "modal"} do %>
      Edit
      <i class="bi bi-pencil-fill"></i>
    <% end %>
  </div>


<div class="flex gap-4 mt-5 overflow-auto items-start" data-controller="dropzone" data-dropzone-model-name-value="list">
  <div class="px-3 py-1 overflow-auto relative contents" data-dropzone-target="drop">
    <%= render @board.lists %>
    <div class="indicator hidden bg-secondary transition-all duration-100 absolute h-full w-1" data-controller="indicator"></div> 
  </div>
  <%= link_to new_board_list_path(@board), class: "btn btn-primary mt-1", data: {turbo_frame: "modal"} do %>
    New list
    <i class="bi bi-plus-square-fill"></i>
  <% end %>
</div>

</div>


