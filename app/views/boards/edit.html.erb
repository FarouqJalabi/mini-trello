<% content_for :title, "Editing board" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing board</h1>

  <turbo-frame id="modal">
    <%= render "form", board: @board %>

    <%= button_to @board, method: :delete, form_class: "contents", class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } do %>
      <i class="bi bi-trash3-fill"></i>
    <% end %>
  </turbo-frame>

  <%= link_to "Show this board", @board, class: "btn" %>
  <%= link_to "Back to boards", boards_path, class: "btn" %>
</div>
