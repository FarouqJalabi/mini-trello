<div id="<%= dom_id list %>" class="bg-base-200 gap-2 min-w-70 sm:min-w-90 max-w-90 flex flex-col p-5 rounded-box relative"
  data-controller="draggable dropzone moveable" data-dropzone-model-name-value="card" data-dropzone-is-horizontal-value="false">
  <div class="flex justify-between ">  
    <h2 class="text-lg font-bold"><%= list.title %></h2>

    <div>
      <%= link_to  edit_list_path(list), class: "btn btn-secondary", data: { turbo_frame: "modal" } do %>
        <i class="bi bi-pencil-fill"></i>
      <% end %>

    </div>
  </div>

  <div data-dropzone-target="drop" class="flex flex-col gap-2 py-1 relative card-holder">
    <%= render list.cards %>
    <div class="indicator hidden bg-secondary transition-all duration-100 absolute w-[80%] h-1 left-[10%]" data-controller="indicator" data-indicator-is-horizontal-value="false"></div>
  </div>
  
  <%= link_to new_list_card_path(list), class: "btn btn-primary btn-soft", data: { turbo_frame: "modal" } do %>
    New card
    <i class="bi bi-plus-square-fill"></i>
  <% end %>
</div>
