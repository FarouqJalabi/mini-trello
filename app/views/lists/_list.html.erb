<div id="<%= dom_id list %>" class="bg-base-200 gap-2 min-w-90 flex flex-col p-5 rounded-box" data-controller="draggable dropzone" data-dropzone-model-name-value="card" data-dropzone-is-horizontal-value="false">
  <div class="flex justify-between ">  
    <h2 class="text-lg font-bold"><%= list.title %></h2>

    <div>
      <%= link_to  edit_list_path(list), class: "btn btn-secondary", data: { turbo_frame: "modal" } do %>
        <i class="bi bi-pencil-fill"></i>
      <% end %>

    </div>
  </div>

  <div data-dropzone-target="drop" class="flex flex-col gap-2">
    <%= render list.cards %>
  </div>
  
  <%= link_to new_list_card_path(list), class: "btn btn-primary btn-soft", data: { turbo_frame: "modal" } do %>
    New card
    <i class="bi bi-plus-square-fill"></i>
  <% end %>
</div>
