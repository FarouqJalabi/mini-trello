<% content_for :title, "New list" %>
<input type="radio" class="theme-controller" name="theme" value="<%= @list.board.theme %>" checked hidden />

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">New list</h1>

  <turbo-frame id="modal">
    <div class="mt-9"></div>
    <%= render "form", list: @list %>
  </turbo-frame>

  <%= link_to "Back to board", @board, class: "btn" %>
</div>
