<h2></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <fieldset class="fieldset flex flex-col bg-base-200 border-base-300 rounded-box w-xs border p-4">
    <legend class="fieldset-legend">Forgot your password?</legend>

    <%= f.label :email, class: "label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>

    <%= f.submit "Send me password reset instructions", class: "btn btn-primary mt-2" %>

    <%= render "devise/shared/links" %>
  </fieldset>
<% end %>
