<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <fieldset class="fieldset flex flex-col bg-base-200 border-base-300 rounded-box w-xs border p-4">
    <legend class="fieldset-legend">Change your password</legend>
    <%= f.hidden_field :reset_password_token %>

    <div class="field">
      <%= f.label :password, class: "label" %>
      <% if @minimum_password_length %>
        <em class="label">(<%= @minimum_password_length %> characters minimum)</em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
    </div>

    <%= f.label :password_confirmation, "Confirm new password", class: "label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>

    <%= f.submit "Change my password", class: "btn btn-primary mt-2" %>
    <div class="flex justify-around">
      <%= render "devise/shared/links" %>
    </div>
  </fieldset>
<% end %>
